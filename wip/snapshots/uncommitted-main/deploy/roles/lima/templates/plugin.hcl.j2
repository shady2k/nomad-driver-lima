# Staged release {{ lima_release_id }}; restart is a separate operator action.
plugin "nomad-driver-lima" {
  config {
    runtime_user = {{ lima_runtime_user | to_json }}
    limactl = {{ lima_limactl | to_json }}
    lima_home = {{ lima_home | to_json }}
    state_dir = {{ lima_state_dir | to_json }}
    template_file = {{ lima_template_dest | to_json }}
    template_sha256 = {{ lima_template_sha256 | to_json }}
    expected_version = {{ lima_expected_version | to_json }}
    memory_overhead_mib = {{ lima_memory_overhead_mib | int }}
    disk_free_floor_mib = {{ lima_disk_free_floor_mib | int }}
  }
}
