# Prepared only. Publish after verifying Authentik's exact user binding and outpost.
apiVersion: v1
kind: Service
metadata:
  name: storage-browser
  namespace: {{ storage_namespace }}
spec:
  selector:
    app: seaweedfs
  ports:
    - name: filer
      port: 8888
      targetPort: 8888
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: storage-browser
  namespace: {{ storage_namespace }}
spec:
  secretName: storage-browser-tls
  dnsNames: [{{ storage_browser_host | to_json }}]
  issuerRef:
    name: letsencrypt-prod
    kind: ClusterIssuer
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: storage-browser-lan
  namespace: {{ storage_namespace }}
  labels:
    ingress: internal
spec:
  ipAllowList:
    sourceRange: {{ storage_browser_source_ranges | to_json }}
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: storage-browser
  namespace: {{ storage_namespace }}
  labels:
    ingress: internal
spec:
  entryPoints: [websecure]
  tls:
    secretName: storage-browser-tls
  routes:
    - kind: Rule
      match: Host(`{{ storage_browser_host }}`) && PathPrefix(`/outpost.goauthentik.io/`)
      priority: 200
      middlewares:
        - name: storage-browser-lan
      services:
        - name: ak-outpost-authentik-embedded-outpost
          namespace: authentik
          port: 9000
    - kind: Rule
      match: Host(`{{ storage_browser_host }}`) && (Method(`GET`) || Method(`HEAD`))
      priority: 100
      middlewares:
        - name: storage-browser-lan
        - name: authentik
          namespace: authentik
      services:
        - name: storage-browser
          port: 8888
