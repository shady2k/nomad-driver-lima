{
  "version": 1,
  "namespace": "agent-workers",
  "datacenters": [
    "REPLACE_WITH_DATACENTER"
  ],
  "task": "worker",
  "owner_id": "00000000-0000-4000-8000-000000000001",
  "agent_instance_id": "00000000-0000-4000-8000-000000000002",
  "nomad_bin": "nomad",
  "receipt_root": "/private/operator/worker-results",
  "catalog_file": "/private/operator/approved-catalog.json",
  "catalog_sha256": "REPLACE_WITH_APPROVED_CATALOG_SHA256",
  "memory_overhead_mib": 128,
  "request_limits": {
    "vcpus": 0,
    "memory_mib": 0,
    "disk_gib": 0
  },
  "guest_bootstrap_command": [
    "/usr/bin/python3",
    "/opt/nomad-workers/task-main.py",
    "--state-dir",
    "/var/tmp/nomad-workers",
    "--session",
    "{session_id}"
  ],
  "guest_node": "/usr/local/bin/node",
  "guest_adapter": "/opt/nomad-workers/adapter.mjs",
  "vault": {
    "role": "agent-worker-prime"
  },
  "guest": {
    "protocol_version": 1,
    "state_dir": "/var/tmp/nomad-workers",
    "workspace": "/workspace/repo",
    "node": "/usr/local/bin/node",
    "launcher": "/opt/nomad-workers/launcher.mjs",
    "acpx_bin": "/usr/local/bin/acpx",
    "acpx_version": "0.21.0",
    "runtime_module": "/opt/worker/acpx/node_modules/acpx/dist/runtime.js",
    "agent_argv": [
      "/usr/local/bin/prime-agent",
      "--mode",
      "acp",
      "--offline"
    ],
    "max_artifact_bytes": 8388608,
    "model": null,
    "runtime_contract": {
      "prime_version": "0.10.1",
      "model": "EXTERNAL_OPERATOR_CONFIG",
      "output_token_budget": "EXTERNAL_OPERATOR_CONFIG"
    },
    "prime_vault": {
      "bao_bin": "/usr/local/bin/bao",
      "address": "https://secrets.example.invalid",
      "secret_path": "secret/data/agent-workers/llm",
      "kernel_python": "/opt/worker/prime/prime-agent-runtime/.venv/bin/python",
      "provider": {
        "name": "model-gateway",
        "base_url": "https://model.example.invalid/v1",
        "model": "OPERATOR_APPROVED_MODEL",
        "max_tokens": 32768,
        "context_window": 128000
      }
    }
  }
}
