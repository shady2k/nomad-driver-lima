# Managed by deploy/ansible/roles/nomad_client (Ansible). Do not edit on the node:
# change the role variables and run the play again.
#
# The Nomad service reads this file through EnvironmentFile= (mode 0600, root
# only). Tokens live here and never in a JSON configuration file, where every
# reader of /etc/nomad.d would see them.
{% if nomad_client_intro_token | length > 0 %}
# The client's introduction token. Nomad reads it from NOMAD_CLIENT_INTRO_TOKEN
# (the -client-intro-token flag does the same thing).
NOMAD_CLIENT_INTRO_TOKEN={{ nomad_client_intro_token }}
{% endif %}
{% if nomad_acl_token | length > 0 %}
# The token the CLI on this node uses (nomad node status, nomad job run, ...).
# The agent itself does not read it.
NOMAD_TOKEN={{ nomad_acl_token }}
{% endif %}
